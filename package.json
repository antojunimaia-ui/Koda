{
  "name": "koda-electron",
  "version": "26.1.5",
  "description": "Koda - Your ideal development partner.",
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "npx rimraf dist-electron dist",
    "dev:clean": "npx rimraf dist-electron && vite",
    "build": "vite build",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:32": "npm run build && electron-builder --win --ia32",
    "dist:all": "npm run build && electron-builder --win --x64 --ia32",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "preview": "vite preview",
    "clear-cache": "node scripts/clear-cache.mjs --confirm"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "ansi-to-html": "^0.7.2",
    "diff": "^8.0.4",
    "discord-rpc": "^4.0.1",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.1.7",
    "globby": "^14.0.2",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "is-unicode-supported": "^2.1.0",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.4",
    "marked-highlight": "^2.2.4",
    "node-pty": "^1.1.0",
    "openai": "^6.34.0",
    "operantid.js": "^1.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.6.0",
    "react-virtuoso": "^4.18.4",
    "vscode-icons-js": "^11.6.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.0",
    "electron": "^41.10.4",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.2.1",
    "typescript": "^6.0.2",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "dompurify": "^3.2.4",
    "esbuild": "^0.28.1",
    "follow-redirects": "^1.15.12",
    "form-data": "^4.0.6",
    "ip-address": "^10.3.1",
    "joi": "^18.2.1",
    "js-yaml": "^4.3.1",
    "qs": "^6.15.2",
    "shell-quote": "^1.8.5",
    "tar": "^7.5.21",
    "tmp": "^0.2.6",
    "undici": "^6.28.0",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.koda.desktop",
    "productName": "Koda",
    "npmRebuild": false,
    "copyright": "Copyright © 2026 Koda",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/node-pty/build",
        "to": "node_modules/node-pty/build"
      },
      {
        "from": "node_modules/node-pty/prebuilds",
        "to": "node_modules/node-pty/prebuilds"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png",
      "identity": null,
      "type": "development",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "afterSign": "scripts/after-sign.cjs",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Koda AI",
      "include": "installer.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/operantid.js/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "antojunimaia-ui",
      "repo": "Koda"
    }
  }
}
