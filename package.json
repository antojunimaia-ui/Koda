{
  "name": "koda-electron",
  "version": "1.0.0",
  "description": "Koda AI - Desktop Edition",
  "main": "dist-electron/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "npx rimraf dist-electron dist",
    "dev:clean": "npx rimraf dist-electron && vite",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.21.0",
    "diff": "^8.0.4",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.1.7",
    "globby": "^14.0.2",
    "highlight.js": "^11.11.1",
    "is-unicode-supported": "^2.1.0",
    "lucide-react": "^0.468.0",
    "marked": "^17.0.5",
    "marked-highlight": "^2.2.3",
    "node-pty": "^1.1.0",
    "openai": "^4.82.0",
    "operantid.js": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/diff": "^7.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.koda.desktop",
    "productName": "Koda",
    "npmRebuild": false,
    "copyright": "Copyright © 2025 Koda",
    "directories": {
      "output": "release-build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/node-pty/build",
        "to": "node_modules/node-pty/build"
      },
      {
        "from": "node_modules/node-pty/prebuilds",
        "to": "node_modules/node-pty/prebuilds"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Koda AI"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/operantid.js/**"
    ]
  }
}
